# Copy to runner/.env (gitignored) and fill in. The environment wins over this file.

# The Convex deployment's HTTP actions URL: https://<deployment>.convex.site,
# or http://127.0.0.1:3211 for a local deployment.
MUG_CONVEX_SITE=https://your-deployment-123.convex.site

# A runner token from the admin page: mugr_ followed by 32 letters and digits.
# It is shown once; the runner never prints it.
MUG_RUNNER_TOKEN=

# Local development only: lets the runner reach a fixture shop on 127.0.0.1 or
# localhost. Leave it unset for real shops.
# MUG_DEV_ALLOW_LOOPBACK=1
